{
  // Lint and format for the whole monorepo (scope feature 2): one config at the root, and Biome follows .gitignore.
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Prose stays as written: Biome 2.6 would reflow every Markdown file.
      "!**/*.md",
      // Generated files are rewritten by their generators, never formatted or linted here.
      "!**/routeTree.gen.ts",
      "!packages/contracts/src/generated",
      "!packages/contracts/openapi.json",
      // packages/ui copies the design system from its artifact (ADR 0003): the token file verbatim, the compiled
      // tokens.css that `pnpm --filter @vetora/ui tokens` rewrites, and the component stylesheet as published.
      "!packages/ui/src/tokens/tokens.json",
      "!packages/ui/styles/tokens.css",
      "!packages/ui/styles/components.css",
      // drizzle-kit's migration folders: snapshot.json beside each hand finished migration.sql.
      "!apps/api/drizzle",
      "!pnpm-lock.yaml",
      // Third party skills and the Claude app's own files.
      "!.agents",
      "!.claude"
    ]
  },
  // The scaffold's style: two spaces, single quotes, no semicolons, trailing commas, lines up to 120 characters.
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  // The tsconfig files carry comments.
  "json": { "parser": { "allowComments": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "style": {
        // verbatimModuleSyntax is on everywhere, so a type only import is written as one.
        "useImportType": "error",
        // Spec 0001, "Repository layout": only src/platform may import a database client (lifted in the override below).
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "pg": "Only apps/api/src/platform creates a database client (spec 0001, Repository layout).",
              "drizzle-orm/node-postgres": "Only apps/api/src/platform creates a database client (spec 0001, Repository layout)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/src/platform/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // Spec 0001: modules reach each other only through their public interface. A module's index.ts is that
      // interface; every other export in a module folder is visible only inside that folder and its subfolders.
      "includes": ["apps/api/src/modules/**"],
      "linter": {
        "rules": {
          "correctness": { "noPrivateImports": { "level": "error", "options": { "defaultVisibility": "package" } } }
        }
      }
    },
    {
      // The design system's component sources, copied from the artifact (ADR 0003) and the repo's since (ADR 0005;
      // every change is in docs/design.md's ledger). These rules read the components' patterns as faults: ARIA
      // composites whose keyboard handling sits on the composite (a listbox under a combobox input, a calendar grid, a
      // menu), scrims and popup anchors that listen for the pointer, a native checkbox in the switch role, effects that
      // list the dependencies they mean to react to, static lists keyed by position, and the table's generic row type.
      // Off for these files only, not the package's tests; each rule is turned back on as the component it reads is
      // fixed here. The components' accessibility is proven where the app composes them (axe, ticket #12) and fixed
      // here.
      "includes": ["packages/ui/src/*.tsx", "!packages/ui/src/*.test.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "noNoninteractiveTabindex": "off",
            "noStaticElementInteractions": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "correctness": { "useExhaustiveDependencies": "off" },
          "suspicious": { "noArrayIndexKey": "off", "noExplicitAny": "off" }
        }
      }
    }
  ]
}
