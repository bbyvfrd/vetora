{
  "openapi": "3.1.0",
  "info": {
    "title": "vetora API",
    "version": "0.1.0",
    "description": "The API behind the clinic web app and, later, the pet owner app. Routes are declared with zod schemas from packages/contracts."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Service health",
        "description": "Reports the API version and whether the database answers. Used by the web app shell and by uptime checks.",
        "responses": {
          "200": {
            "description": "The API and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "unavailable"
                      ]
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "database",
                    "time"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer (problem details)"
          }
        }
      }
    },
    "/api/auth/sign-in/username": {
      "post": {
        "summary": "Sign in",
        "description": "Signs a staff member in with `handle@practice-code` and a password and sets the session cookie, which ends 12 hours later. Every refusal of the credentials answers the same 401, whichever part was wrong (story 4).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed in: the session cookie is set"
          },
          "401": {
            "description": "The clinic code, username or password is not right (problem details)"
          },
          "403": {
            "description": "The request does not come from the app's own origin (problem details)"
          },
          "429": {
            "description": "Too many attempts from this client for now (problem details)"
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "summary": "Sign out",
        "description": "Ends the session: its row is deleted and its cookie cleared.",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "There is no session to end (problem details)"
          },
          "403": {
            "description": "The request does not come from the app's own origin (problem details)"
          }
        }
      }
    },
    "/api/auth/get-session": {
      "get": {
        "summary": "The current session",
        "description": "The signed in session and its login, or null. The session token stays in its cookie.",
        "responses": {
          "200": {
            "description": "The session, or null",
            "content": {
              "application/json": {
                "schema": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "session": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "userId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "id",
                        "userId",
                        "expiresAt"
                      ]
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "language": {
                          "type": "string",
                          "enum": [
                            "az",
                            "ru",
                            "en"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "username",
                        "language"
                      ]
                    }
                  },
                  "required": [
                    "session",
                    "user"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client for now (problem details)"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Who is signed in",
        "description": "The signed in person, their practice with their roles, and its active locations with the default marked.",
        "responses": {
          "200": {
            "description": "The signed in person",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "language": {
                      "type": "string",
                      "enum": [
                        "az",
                        "ru",
                        "en"
                      ]
                    },
                    "practice": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "roles": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "manager",
                              "veterinarian",
                              "assistant",
                              "receptionist",
                              "groomer"
                            ]
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "code",
                        "roles"
                      ]
                    },
                    "locations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "isDefault"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "displayName",
                    "language",
                    "practice",
                    "locations"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No session (problem details)"
          },
          "403": {
            "description": "The login has no active practice (problem details)"
          }
        }
      }
    },
    "/api/me/language": {
      "put": {
        "summary": "Save the person's language",
        "description": "Saves the interface language to the login, so it follows the person to any computer.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "enum": [
                      "az",
                      "ru",
                      "en"
                    ]
                  }
                },
                "required": [
                  "language"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Saved"
          },
          "400": {
            "description": "Not one of az, ru and en (problem details)"
          },
          "401": {
            "description": "No session (problem details)"
          }
        }
      }
    }
  },
  "webhooks": {}
}
