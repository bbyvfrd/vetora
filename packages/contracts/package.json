{
  "name": "@vetora/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "openapi-typescript ./openapi.json -o ./src/generated/api.ts"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vetora/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:"
  }
}
