    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "clinical_observation",
        "name": "clinical_observation_kind_check",
        "value": "\"kind\" in ('weight', 'temperature', 'pulse', 'respiratory_rate', 'body_condition', 'other')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "clinical_observation",
        "name": "clinical_observation_unit_check",
        "value": "case \"kind\" when 'weight' then \"unit\" = 'kg' when 'temperature' then \"unit\" = '°C' when 'pulse' then \"unit\" = '/min' when 'respiratory_rate' then \"unit\" = '/min' else \"unit\" ~ '\\S' end",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "clinical_observation",
        "name": "clinical_observation_occurred_at_check",
        "value": "\"occurred_at\" <= now()",
        "entityType": "checks"
      }
    }
  ]
