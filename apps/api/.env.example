# Local development values for the main folder (slot 0). pnpm local:setup writes .env (ignored by git) from this file
# with the checkout's own ports (docs/agents/worktrees.md). Staging and production get these through Kamal secrets.
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
PUBLIC_ORIGIN=http://localhost:5173
# Signs the session cookies (Better Auth), 32 characters or more. A local value only: staging and production each get
# their own through the Kamal secrets (openssl rand -base64 32).
BETTER_AUTH_SECRET=local-only-better-auth-secret-not-for-servers

# Local Postgres from compose.yaml (no pooler locally, so both URLs point at the server).
DATABASE_URL_POOLED=postgres://vetora_app:vetora_app@localhost:5432/vetora
DATABASE_URL_DIRECT=postgres://vetora_app:vetora_app@localhost:5432/vetora

# Used by the operator commands (migrate, provision-practice, add-staff), never by the running API; the commands that
# make logins (provision-practice, add-staff, reset-password) read the variables above as well.
DATABASE_URL_MIGRATOR=postgres://vetora_migrator:vetora_migrator@localhost:5432/vetora

# Leave unset locally; errors then stay in the terminal.
# SENTRY_DSN_API=
