# personal Claude Code settings (plugin toggles, permissions)
.claude/settings.local.json
# the worktrees Claude Code and the Claude app create, one per task (AGENTS.md, Worktrees): whole checkouts
.claude/worktrees/
# written per checkout by pnpm local:setup with that checkout's ports
.claude/launch.json

# OS noise
.DS_Store

# dependencies and build output
node_modules/
dist/
.turbo/
out/

# local environment files (keep the examples)
.env
.env.*
!.env.example

# deploy secrets: Kamal reads these files; they must never be committed
.kamal/secrets
.kamal/secrets.*
!.kamal/secrets-common
infra/.state/

# per developer git hook overrides
lefthook-local.yml

# Vitest artifacts (reports, attachments)
.vitest/
