# The local environment of this checkout: written by `pnpm local:setup` (infra/local-env.sh), ignored by git, read by
# Compose (compose.yaml) and Vite (apps/clinic-web/vite.config.ts); the API reads apps/api/.env. One slot per
# checkout: 0 is the main checkout, a worktree under .claude/worktrees takes the lowest free number, and every port is
# the default plus the slot. Prefer the command to a copy of this file: it also picks a free slot in a worktree.
VETORA_SLOT=0
COMPOSE_PROJECT_NAME=vetora
VETORA_POSTGRES_PORT=5432
VETORA_S3_PORT=8333
VETORA_API_PORT=3000
VETORA_WEB_PORT=5173
